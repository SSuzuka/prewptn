# ============================================================================
# Скопируйте в .env:  cp .env.example .env
# Все значения по умолчанию — in-memory, поэтому `uv run python scripts/demo.py`
# работает сразу, без Docker, PostgreSQL, Redis, Qdrant и без LLM-ключа.
# ============================================================================

# ---------------------------------------------------------------------------
# Очередь задач
# memory - InMemoryBroker (только dev/тесты: нет сети, нет ack)
# redis  - RedisStreamBroker (PRODUCTION: ack + redelivery при падении воркера)
# ---------------------------------------------------------------------------
BROKER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
TASKIQ_QUEUE=aicore:tasks

# ---------------------------------------------------------------------------
# База данных
# dev : sqlite+aiosqlite:///./local.db
# prod: postgresql+asyncpg://user:pass@localhost:5432/aicore
# ---------------------------------------------------------------------------
DB_URL=sqlite+aiosqlite:///./local.db

# ---------------------------------------------------------------------------
# Векторное хранилище (RAG)
# memory - AsyncQdrantClient(":memory:"), in-process
# qdrant - отдельный Qdrant-сервер
# ---------------------------------------------------------------------------
VECTOR_BACKEND=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aicore_documents
QDRANT_API_KEY=
EMBEDDING_DIM=384

# ---------------------------------------------------------------------------
# Эмбеддинги (RAG)
# stub  - детерминированные хэш-эмбеддинги (dev/тесты, без сети и ключей)
# local - fastembed (ONNX): бесплатно и локально, без API-ключа (extra `embeddings`)
# openai - любой OpenAI-совместимый /embeddings (нужен OPENAI_API_KEY)
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=stub
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
EMBEDDING_PRICE_PER_1K=0.0

# ---------------------------------------------------------------------------
# LLM
# stub  - детерминированный, без ключей и без сети (по умолчанию)
# openai - любой OpenAI-совместимый endpoint
# ---------------------------------------------------------------------------
LLM_BACKEND=stub
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# RAG: чанкинг, поиск, бюджет контекста
# ---------------------------------------------------------------------------
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVE_LIMIT=5
RAG_RETRIEVE_FETCH_K=20
RAG_HYBRID_ENABLED=true
RAG_CONTEXT_MAX_CHARS=6000

# ---------------------------------------------------------------------------
# Агенты (create_agent: supervisor + subagents, RAG как tool)
# stub   - детерминированная LangChain-модель с tool calling (dev/тесты)
# openai - ChatOpenAI на том же OpenAI-совместимом endpoint'е (extra `openai`)
# ---------------------------------------------------------------------------
AGENT_BACKEND=stub
AGENT_MODEL=gpt-4o-mini
AGENT_TEMPERATURE=0.0
# Guardrails цикла: лимиты вызовов модели/инструментов и шагов графа.
AGENT_MAX_MODEL_CALLS=10
AGENT_MAX_TOOL_CALLS=15
AGENT_RECURSION_LIMIT=25
# >0 — сжимать историю при превышении (SummarizationMiddleware); 0 — выключено.
AGENT_SUMMARIZE_TRIGGER_TOKENS=0
# Предел числа веток (thread_id) в in-memory чекпойнтере; старейшие вытесняются.
AGENT_MAX_THREADS=256

# ---------------------------------------------------------------------------
# Надёжность: timeouts, retries, lease
# ---------------------------------------------------------------------------
TASK_MAX_RETRIES=3
TASK_RETRY_DELAY_SECONDS=5
TASK_RETRY_USE_JITTER=true
TASK_RETRY_USE_EXPONENT=true
TASK_TIMEOUT_SECONDS=120
# Lease «живой» RUNNING-задачи: по истечении её можно перезахватить после
# падения воркера. Должен быть больше TASK_TIMEOUT_SECONDS.
TASK_LEASE_SECONDS=300
# Как часто фоновый purge-цикл воркера ищет просроченные RUNNING-задачи.
TASK_LEASE_SWEEP_INTERVAL_SECONDS=30
# Safety net: PENDING старше этого порога переставляется в очередь, если
# taskiq scheduler не запущен/потерял сообщение. Должен быть больше max backoff.
TASK_PENDING_SWEEP_SECONDS=600
# Не воскрешать PENDING старше этого возраста (2 суток).
TASK_PENDING_MAX_AGE_SECONDS=172800
# Префикс ключей Redis для отложенных ретраев (backoff в проде).
# Двоеточия не поддерживаются: taskiq-redis парсит ключ через split(':', 2).
# Старое значение с ':' нормализуется в '-' с предупреждением.
TASK_RETRY_SCHEDULE_PREFIX=aicore-retry-schedules
LLM_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=8
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1

# Цена за 1000 токенов в USD — для метрик стоимости (prompt/completion).
LLM_PRICE_PROMPT_PER_1K=0.00015
LLM_PRICE_COMPLETION_PER_1K=0.0006

# Rate limiting API (запросов в минуту на клиента)
API_RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Наблюдаемость
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# Langfuse: без ключей SDK работает как no-op, локальный запуск не ломается.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

OTEL_SERVICE_NAME=aicore
# Пустой = трейсы не экспортируются наружу (считаются, но не отправляются)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Наблюдаемость воркера
# Счётчики задач/LLM живут в процессе ВОРКЕРА, а `/metrics` отдаёт API.
# Воркер поднимает собственный Prometheus-экспортёр на этом порту — добавьте
# его второй целью скрейпа. 0 = экспортёр выключен.
# host по умолчанию loopback: у экспортёра нет аутентификации. Для скрейпа из
# другого контейнера задайте 0.0.0.0 и сетевую политику.
WORKER_METRICS_PORT=9100
WORKER_METRICS_HOST=127.0.0.1
# Для `taskiq worker --workers N`: общий каталог, куда все процессы пишут
# метрики; один exporter отдаёт агрегат. В compose это tmpfs на worker.
# PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --------------------------------------------------------------
# API
# --------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# CORS: origin'ы через запятую (пусто = мидлварь выключен)
CORS_ORIGINS=http://localhost:3000
# Аутентификация по ключу: список X-API-Key через запятую.
# Пусто = auth выключен (dev/MVP). Профиль docker compose `app` требует
# непустой API_KEYS и иначе не стартует (fail closed).
API_KEYS=
# Доверять X-Forwarded-For при определении клиента лимитера.
# Включать ТОЛЬКО за доверенным прокси/ingress: иначе заголовок подделываем.
# Берётся элемент со сдвигом TRUSTED_PROXY_COUNT от конца (1 = правый адрес,
# его дописал ваш прокси; левые задаёт клиент).
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_COUNT=1
# Максимум одновременных SSE-потоков на процесс; сверх лимита — 503.
SSE_MAX_CONCURRENT_STREAMS=100
